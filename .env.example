# Copy to .env (or export) - pick ONE provider. With nothing set the sample uses its offline stub model.
# PART_EQ_PROVIDER=stub            # force: openai | azure_openai | foundry | stub

# OpenAI (Responses API)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Azure OpenAI (Responses API, Entra ID via `az login`; needs the "azure" extra)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com   (or https://<resource>.cognitiveservices.azure.com)
# AZURE_OPENAI_MODEL=<deployment-name>

# Microsoft Foundry project (Entra ID via `az login`; needs the "foundry" extra)
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=<deployment-name>

# Optional
# RESEARCH_BACKGROUND=1            # OpenAI/Azure OpenAI: run web research in Responses background mode
# STUB_LATENCY_SCALE=1             # stub only: 0 disables simulated latency
